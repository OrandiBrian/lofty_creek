# Django
SECRET_KEY=your-super-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app.onrender.com,localhost
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# Database (automatically set by Render)
DATABASE_URL=

# Africa's Talking SMS
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-api-key-here
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_WEBHOOK_TOKEN=replace-with-a-long-random-token
SMS_SEND_ASYNC=True
REDIS_URL=redis://localhost:6379/0

# Durable media uploads (S3-compatible storage)
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=af-south-1
AWS_S3_CUSTOM_DOMAIN=

# Email notifications for website inquiries
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=info@loftycreekchristianschool.org
EMAIL_HOST_PASSWORD=replace-with-an-email-app-password
DEFAULT_FROM_EMAIL=info@loftycreekchristianschool.org
INQUIRY_NOTIFICATION_EMAIL=info@loftycreekchristianschool.org

# Optional public links (hidden when left blank)
FACEBOOK_URL=https://www.facebook.com/share/18xADNP3RU/?mibextid=wwXIfr
INSTAGRAM_URL=https://www.instagram.com/loftycreekchristianschool
YOUTUBE_URL=https://youtube.com/@loftycreekchristianschool1985?si=vI3aeh-iqjMF4u4T
